{
  "id": "shadowbroker",
  "name": "Shadowbroker",
  "tagline": "A global intelligence console on your own metal.",
  "description": "An OSINT situational-awareness globe: flights, ships, satellites, quakes, wildfires and more on one MapLibre map. The most on-brand app for Rasputin.",
  "collection": "show-off",
  "category": "data",
  "arch": "both",
  "ramFloorMB": 4096,
  "deployBudgetSeconds": 1800,
  "needsFeedKey": [
    "OpenSky",
    "AISStream"
  ],
  "exposureDefault": "lan-only",
  "ports": [
    {
      "name": "web",
      "container": 3000,
      "published": 3200,
      "protocol": "tcp",
      "web": true
    },
    {
      "name": "api",
      "container": 8000,
      "published": 8200,
      "protocol": "tcp"
    }
  ],
  "requires": [
    "tile.web-port",
    "tile.secrets",
    "tile.operator-secrets"
  ],
  "operatorSecrets": [
    {
      "name": "ais-api-key",
      "label": "AISStream API key (ships)",
      "required": false
    },
    {
      "name": "opensky-client-id",
      "label": "OpenSky client ID (flights)",
      "required": false
    },
    {
      "name": "opensky-client-secret",
      "label": "OpenSky client secret (flights)",
      "required": false
    },
    {
      "name": "gfw-api-token",
      "label": "Global Fishing Watch API token",
      "required": false
    },
    {
      "name": "windy-api-key",
      "label": "Windy API key",
      "required": false
    },
    {
      "name": "finnhub-api-key",
      "label": "Finnhub API key",
      "required": false
    },
    {
      "name": "airframes-api-key",
      "label": "Airframes API key",
      "required": false
    }
  ],
  "volumes": [
    {
      "name": "shadowbroker-data",
      "backup": "state",
      "quiesce": "stop"
    }
  ],
  "website": "https://github.com/bigbodycobain/shadowbroker",
  "icon": "\ud83d\udef0\ufe0f",
  "postInstall": "Works without keys. For full flight and ship coverage, add your OpenSky and AISStream keys under SECRETS in its Apps drawer; saving them redeploys it."
}
