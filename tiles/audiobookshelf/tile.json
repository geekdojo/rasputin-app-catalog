{
  "id": "audiobookshelf",
  "name": "Audiobookshelf",
  "tagline": "Your audiobooks and podcasts, with great phone apps.",
  "description": "A self-hosted server for your audiobook and podcast library, with progress sync across excellent iOS and Android apps. Point it at a folder and go.",
  "collection": "everyday",
  "arch": "both",
  "placementHint": "any",
  "ramFloorMB": 1024,
  "exposureDefault": "lan-only",
  "ports": [
    {
      "name": "web",
      "container": 80,
      "published": 13378,
      "protocol": "tcp",
      "web": true
    }
  ],
  "requires": [
    "tile.web-port"
  ],
  "volumes": [
    {
      "name": "abs-config",
      "backup": "state",
      "quiesce": "stop"
    },
    {
      "name": "abs-metadata",
      "backup": "state",
      "quiesce": "stop"
    },
    {
      "name": "abs-audiobooks",
      "backup": "bulk",
      "quiesce": "none"
    },
    {
      "name": "abs-podcasts",
      "backup": "bulk",
      "quiesce": "none"
    }
  ],
  "website": "https://github.com/advplyr/audiobookshelf",
  "icon": "\ud83c\udfa7",
  "postInstall": "Open it, create your admin account, then add an audiobook or podcast library folder.",
  "category": "media"
}
